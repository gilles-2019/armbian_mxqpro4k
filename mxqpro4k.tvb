# Allwinner H3 quad core 1GB SoC WiFi eMMC
BOARD_NAME="MxqPro4K"
BOARD_VENDOR="sunvell"
BOARDFAMILY="sun8i"
BOARD_MAINTAINER=""
INTRODUCED="2015"
MODULES_BLACKLIST="cpufreq_dt"
DEFAULT_OVERLAYS="usbhost1 usbhost2"
BOOTCONFIG="mxqpro4k_defconfig"
KERNEL_TARGET="current,edge,legacy"
KERNEL_TEST_TARGET="edge"
BOOT_FDT_FILE="sun8i-h3-mxqpro4k.dtb"
BOOTDELAY=5
BOOT_LOGO="yes"

