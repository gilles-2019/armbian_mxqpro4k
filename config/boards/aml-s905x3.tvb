# Amlogic S905X3 SEI610 configuration
BOARD_NAME="SEI610"
BOOT_LOGO="desktop"

# Architecture et Famille
ARCH="arm64"
LINUX_FAMILY="meson64"
BOARDFAMILY="meson64"
CHIP_FAMILY="sm1"
BOOTCONFIG="sei610_defconfig"

# Noyau et Device Tree
KERNEL_TARGET="current,edge"
DEFAULT_KERNEL_CONFIG="linux-meson64-current.config"
DTB_FILE="amlogic/meson-sm1-sei610.dtb"

# Bootloader
BOOT_SOURCE="u-boot"
UBOOT_CONFIG="sei610" 
#UBOOT_TARGET_MAP="u-boot-s905x3"
#UBOOT_CONFIG="sei610_defconfig"

# Paramètres d'image
BOOT_SIZE="256"
BOOTFS_TYPE="fat"
ROOTFS_TYPE="ext4"
EXTLINUX_FDT_PATH="/dtb/amlogic/meson-sm1-sei610.dtb"


