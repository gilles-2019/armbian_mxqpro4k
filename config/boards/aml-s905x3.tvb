# Amlogic S905X3 SEI610 configuration
BOARD_NAME="SEI610"
BOOT_LOGO="desktop"

# Architecture et Famille
ARCH="arm64"
LINUX_FAMILY="meson64"
#BOARDFAMILY="meson64"
#BOARDFAMILY="meson-gxl"
#BOARD_VENDOR="amlogic"
CHIP_FAMILY="sm1"
BOOTCONFIG="sei610_defconfig"

# Noyau et Device Tree
KERNEL_TARGET="current,edge"
DEFAULT_KERNEL_CONFIG="linux-meson64-current.config"
DTB_FILE="amlogic/meson-sm1-sei610.dtb"

# Bootloader
BOOT_SOURCE="u-boot"
UBOOT_CONFIG="sei610" 
UBOOT_TARGET_MAP="u-boot.bin.sd.bin" # Nom attendu par le packageur Armbian
#UBOOT_TARGET_MAP="u-boot-s905x3"
#UBOOT_CONFIG="sei610_defconfig"

# Paramètres d'image
BOOT_SIZE="512"
BOOTFS_TYPE="fat"
ROOTFS_TYPE="ext4"
EXTLINUX_FDT_PATH="/dtb/amlogic/meson-sm1-sei610.dtb"

#
BOOT_SCRIPT_TYPE="extlinux"
#
# Use extlinux and u-boot-menu extension
#declare -g SRC_EXTLINUX="yes"
#declare -g SRC_CMDLINE="rootflags=data=writeback loglevel=7 splash=verbose console=ttyAML0,115200 console=tty0" 
#enable_extension "u-boot-menu"  # this generates the extlinux.conf

