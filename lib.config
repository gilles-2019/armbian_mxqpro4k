# cp "${USERPATCHES_PATH}/mxqpro4k.tvb" "${SRC}/config/boards/mxqpro4k.tvb"


EXTRA_PACKAGES_IMAGE="avahi-daemon libnss-mdns net-tools vim"
EXTRA_PACKAGES_IMAGE_REFS="package:avahi-daemon:custom package:libnss-mdns:custom package:net-tools:custom package:vim:custom"

# Générateur de traces corrigé
# On filtre pour ne garder que les noms de hooks valides (lettres, chiffres, underscores)

ARMBIAN_HOOKS_LIST=$(grep -r "call_extension_method" "${SRC}/lib" | \
    grep -v '^ *#' | \
    sed -n "s/.*call_extension_method ['\"]\([^'\"]*\)['\"].*/\1/p" | sort | uniq)

for hook_name in $ARMBIAN_HOOKS_LIST; do
    # ÉVITER L'ERREUR : Si le nom contient un '$', on l'ignore car c'est un hook dynamique 
    # (Bash ne peut pas définir une fonction avec une variable dans son nom)
    if [[ "$hook_name" == *"\$"* || "$hook_name" == *"{"* ]]; then
        continue
    fi

    # Nettoyage des caractères invisibles
    clean_name=$(echo "$hook_name" | tr -dc '[:alnum:]_')
    
    if [[ -n "$clean_name" ]]; then
        eval "
        ${clean_name}__display_fn_name() {
            display_alert \"Execution: ${clean_name}__display_fn_name\" \"HOOK-TRACE\" \"info\"
        }
        "
    fi
done

display_alert \"Traceur activé : les hooks dynamiques ont été ignorés pour éviter les erreurs Bash.\" \"DEBUG\" \"info\"

