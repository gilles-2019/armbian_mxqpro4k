cp "${USERPATCHES_PATH}/mxqpro4k.tvb" "${SRC}/config/boards/mxqpro4k.tvb"
cp "${USERPATCHES_PATH}/t95max.tvb" "${SRC}/config/boards/t95max.tvb"
EXTRA_PACKAGES_IMAGE="avahi-daemon libnss-mdns net-tools vim"
EXTRA_PACKAGES_IMAGE_REFS="package:avahi-daemon:custom package:libnss-mdns:custom package:net-tools:custom package:vim:custom"

user_config_post_build_uboot() {
    display_alert "PostBuildUboot" "Execution du user_config_post_build_uboot..." "info"
    # On cible uniquement le S905X3
    if [[ $CHOSEN_SOC == "s905x3" || $BOARD == "t95max" ]]; then
        display_alert "Amlogic FIP" "Vérification des outils de signature..." "info"

        local fip_tools="$EXTER_USERPATCHES/amlogic-boot-fip"
        local raw_uboot="$SDCARD/usr/lib/linux-u-boot-${BRANCH}-${BOARD}/u-boot.bin"

        # ÉTAPE 1 : Récupération automatique des outils si absents
        if [ ! -f "$fip_tools/build-fip.sh" ]; then
            display_alert "Amlogic FIP" "Téléchargement des outils LibreELEC..." "info"
            git clone --depth=1 https://github.com "$fip_tools"
        fi

        # ÉTAPE 2 : Signature FIP
        display_alert "Amlogic FIP" "Signature du binaire pour T95Max..." "info"
        cd "$fip_tools"
        # On utilise le profil 'sei610' car c'est la base SM1 (S905X3)
        ./build-fip.sh sei610 "$raw_uboot" "$fip_tools/output"

        # ÉTAPE 3 : Préparation pour le chainloader
        # On copie le binaire signé pour que customize-image.sh le trouve
        cp "$fip_tools/output/u-boot.bin.sd.bin" "$SDCARD/u-boot.ext"
        display_alert "Amlogic FIP" "Binaire u-boot.ext prêt" "success"
    fi
}
