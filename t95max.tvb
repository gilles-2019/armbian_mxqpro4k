# t95max tvbox Amlogic s905x3 4gigRam 32Gig emmc SoC WiFi eMMC
BOARD_NAME="t95max"
BOARD_VENDOR="turewell"
BOARDFAMILY="meson-sm1"
BOARD_MAINTAINER="Gilles"
INTRODUCED="2020"
BOOTCONFIG="odroid-c4_defconfig"
MODULES_BLACKLIST="simpledrm" # SimpleDRM conflicts with Panfrost
KERNEL_TARGET="current,edge,legacy"
KERNEL_TEST_TARGET="edge"
BOOT_FDT_FILE="meson-sm1-x96-max-plus-100m.dtb"
BOOTDELAY=5
BOOT_LOGO="desktop"

