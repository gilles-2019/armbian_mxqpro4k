# t95max tvbox Amlogic s905x3 4gigRam 32Gig emmc SoC WiFi eMMC
BOARD_NAME="T95Max"
BOARDFAMILY="meson64"
BOARD_MAINTAINER="Gilles C"
BOOT_LOGO="yes"

# Architecture et Noyau
ARCH="arm64"
# On utilise le noyau mainline "current" ou "edge"
KERNEL_TARGET="current,edge"
FULL_DESKTOP="no"

# Configuration U-Boot spécifique (votre patch defconfig précédent)
UBOOT_TARGET_MAP="sei610:sei610_defconfig"

# Device Tree par défaut (SM1 SEI610 est le plus compatible)
DEFAULT_FDT="amlogic/meson-sm1-sei610.dtb"

# Paramètres de boot
BOOT_SUPPORT_SPI="no"


